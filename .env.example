# ─────────────────────────────────────────────────────────────────────────────
# Скопируй в .env и заполни. Файл .env в git не попадает (см. .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── VK-бот (обязательно) ─────────────────────────────────────────────────────
# Токен сообщества: Управление → Работа с API → Ключи доступа.
# Нужны права «Сообщения». Без него бот не стартует.
VK_TOKEN=
# VK user_id владельца. Это owner панели: только он управляет админами.
# Одно и то же значение читают и бот, и панель — не разводите ADMIN_ID/ADMIN_VK_ID.
ADMIN_ID=

# ── Веб-панель (обязательно) ─────────────────────────────────────────────────
# Секрет подписи сессий. Сгенерировать:  python -c "import secrets;print(secrets.token_hex(32))"
# Панель не стартует, если пусто. Смена значения разлогинит всех.
PANEL_SECRET=
# Публичный URL панели. Если начинается с https:// — включаются Secure-куки и
# SameSite=None (нужно для VK Mini App) плюс HSTS.
PANEL_BASE_URL=http://127.0.0.1:5000

# Интерфейс и порт. За nginx оставляйте 127.0.0.1 — панель не должна смотреть
# в интернет напрямую.
PANEL_HOST=127.0.0.1
PANEL_PORT=5000

# Сколько реальных прокси стоит перед приложением.
# ⚠️ Ставите nginx из deploy/nginx-panel.conf — здесь ДОЛЖНА быть 1.
# Оставите 0 за nginx — все клиенты станут 127.0.0.1: десять неудачных кодов
# от одного человека заблокируют вход всем, а IP в аудите будут бесполезны.
# И наоборот, 1 без реального прокси = IP подделывается заголовком и per-IP
# лимит на /login/code обходится. Значение по умолчанию — для запуска без nginx.
PANEL_TRUSTED_PROXIES=0

# Лимит размера загружаемого файла расписания, МБ.
PANEL_MAX_UPLOAD_MB=16

# ── REST API загрузки расписания (опционально) ───────────────────────────────
# Bearer-токен для /api/schedule/*. Пусто = API выключено (отдаёт 401).
# Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(32))"
UPLOAD_API_TOKEN=

# ── Поддержка и юридические документы ────────────────────────────────────────
# ID сообщества бота: из него собирается ссылка «Написать в поддержку»
# (правила VK Mini Apps, п. 2.4.1). Можно вместо этого задать SUPPORT_URL целиком.
VK_GROUP_ID=
# Кто предоставляет сервис: ФИО или наименование юрлица. Подставляется в
# /privacy и /terms — 152-ФЗ требует назвать оператора персональных данных,
# а типовые документы VK (п. 1.3) — назвать разработчика в самом приложении.
# Пусто = безличная заглушка, для закона её недостаточно.
DEVELOPER_NAME=

# ── VK Mini App (опционально) ────────────────────────────────────────────────
# Нужны для проверки подписи launch-параметров. Без них бесшовный вход не
# работает: подпись проверить нечем, и остаётся только одноразовый код.
VK_APP_ID=
VK_APP_SECRET=

# Сколько живёт подписанный запуск Mini App: старше — вход только по коду.
VK_LAUNCH_MAX_AGE_SEC=86400

# Лимит запросов с одного IP в минуту (правила VK Mini Apps, п. 1.2.6).
# 0 — выключить. Мониторинг /healthz и статика не считаются.
PANEL_RATE_LIMIT_RPM=240

# ── Легаси Telegram-бот (опционально, bot.py) ────────────────────────────────
# Новый функционал в него не добавляется. Не запускайте, если он не нужен.
TOKEN=
YANDEXGPT_API_KEY=
# SOCKS5-прокси для Telegram, через запятую. Пусто = прямое соединение.
# Не вписывайте сюда случайные публичные прокси: через них уйдёт токен бота
# и переписка пользователей.
TELEGRAM_PROXIES=

# ── Пути к данным (опционально) ──────────────────────────────────────────────
# По умолчанию все базы лежат в корне проекта. DATA_DIR переносит их разом —
# например на volume. Бот и панель ДОЛЖНЫ видеть одни и те же значения, иначе
# панель зальёт расписание в файл, который бот не читает.
DATA_DIR=
# Точечные переопределения, если разложить нужно по-разному:
NOTES_DB=
SCHEDULE_DB=
SCHEDULE_VERSIONS_DIR=
# Файл-маркер hot-reload: панель его трогает, бот следит за mtime.
SCHEDULE_RELOAD_MARKER=
# База легаси Telegram-бота, которую панель обновляет заодно с основной.
LEGACY_SCHEDULE_DB=

# ── Дополнительные владельцы панели ──────────────────────────────────────────
# Несколько владельцев через запятую. Владельцы из env — единственные, кого
# нельзя снять через веб-интерфейс, поэтому впишите сюда запасной аккаунт:
# иначе потеря доступа к основному VK = потеря владения, и вернуть его сможет
# только тот, у кого есть доступ к серверу.
#   ADMIN_VK_IDS=123456,654321
ADMIN_VK_IDS=
