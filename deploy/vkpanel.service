# Веб-панель. Установка:
#   # один раз: пользователь без shell, данные отдельно от кода
#   useradd --system --home /var/lib/vkbot --shell /usr/sbin/nologin vkbot
#   mkdir -p /var/lib/vkbot && chown vkbot:vkbot /var/lib/vkbot
#   # /root обычно 0700 — без traverse vkbot не войдёт в /root/vkbot
#   chmod 711 /root
#   chown -R root:vkbot /root/vkbot && chmod -R g+rX /root/vkbot
#   # SQLite WAL пишет -wal/-shm рядом с .db → каталог проекта нужен на запись
#   chmod 2775 /root/vkbot
#   chown vkbot:vkbot /root/vkbot/*.db /root/vkbot/schedule_versions /root/vkbot/.schedule_reload 2>/dev/null || true
#   chmod 640 /root/vkbot/.env && chgrp vkbot /root/vkbot/.env
#   cp deploy/vkpanel.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now vkpanel
#   journalctl -u vkpanel -f
#
# ВАЖНО: ровно один процесс и один поток-владелец состояния.
# _PENDING_UPLOADS / _LAST_BROADCAST / _ICS_CACHE живут в памяти процесса, поэтому
# несколько воркеров сломают загрузку расписания («unknown or expired token»).
# Масштабировать можно только после переноса этого состояния в БД.
# Отсюда «-w 1»: потоки (--threads) состояние разделяют, процессы — нет.
#
# Порт 8080 должен совпадать с proxy_pass в deploy/nginx-panel.conf.
#
# Access-лог без query: %(U)s — путь без ?vk_*&sign=… (иначе journald хранит
# launch-credential Mini App).

[Unit]
Description=VK bot admin panel (gunicorn)
After=network-online.target vkbot.service
Wants=network-online.target

[Service]
Type=simple
User=vkbot
Group=vkbot
WorkingDirectory=/root/vkbot
# .env читает сам процесс через python-dotenv — см. комментарий в vkbot.service.
ExecStart=/root/vkbot/venv/bin/gunicorn -b 127.0.0.1:8080 -w 1 -k gthread --threads 4 --timeout 60 --control-socket /run/vkpanel/gunicorn.ctl --access-logfile - --access-logformat '%%(h)s %%(t)s "%%(m)s %%(U)s" %%(s)s %%(b)s' --error-logfile - web_panel:app
RuntimeDirectory=vkpanel
Restart=always
RestartSec=5
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vkpanel

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/root/vkbot /var/lib/vkbot

[Install]
WantedBy=multi-user.target
